# Low-strain setup. Warm, low-saturation palette. Follows macOS light/dark.
theme = dark:Gruvbox Material Dark,light:Gruvbox Material Light

# text
font-family = Menlo
font-size = 15
adjust-cell-height = 30%
font-thicken = false
bold-is-bright = false
minimum-contrast = 1.3

# scrollback per split, in bytes (default 10 MB). Long logs stay scrollable.
# Inside herdr, herdr's own scrollback_limit_bytes applies instead.
scrollback-limit = 100000000

# no flicker sources
cursor-style = bar
cursor-style-blink = false

# breathing room
window-padding-x = 20
window-padding-y = 14
window-padding-balance = true
mouse-hide-while-typing = true
macos-titlebar-style = hidden

# selection goes straight to the system clipboard, like wezterm and herdr
copy-on-select = clipboard

# No tab keybinds here on purpose. With the titlebar hidden the window leaves
# the macOS native tab group, and every switching action (goto_tab, next_tab,
# cmd+shift+[/]) goes through that group, so none of them fire. cmd+t still
# makes a tab you can never get back to. Use splits instead: cmd+d, cmd+shift+d,
# cmd+[ / cmd+], cmd+opt+arrows. Ghostty draws those itself.
