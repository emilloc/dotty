# Low-strain setup. Warm, low-saturation palette. Follows macOS light/dark.
theme = dark:Gruvbox Material Dark,light:Gruvbox Material Light

# text
font-family = Menlo
font-size = 15
adjust-cell-height = 30%
font-thicken = false
bold-is-bright = false
minimum-contrast = 1.3

# no flicker sources
cursor-style = bar
cursor-style-blink = false

# breathing room
window-padding-x = 20
window-padding-y = 14
window-padding-balance = true
mouse-hide-while-typing = true
macos-titlebar-style = tabs
