#!/bin/sh
set -eu

launcher=$0
while [ -L "$launcher" ]; do
    link=$(readlink "$launcher") || exit 1
    case "$link" in
        /*) launcher=$link ;;
        *) launcher=${launcher%/*}/$link ;;
    esac
done
root=$(CDPATH= cd -- "${launcher%/*}" && pwd)

# Extensions load from ~/.pi/agent/extensions (linked by setup), so plain `pi` has them too.
# This launcher only adds Spark model discovery and the research prompt.

if [ -x "$HOME/.pi/agent/bin/pi" ]; then
    pi_command=$HOME/.pi/agent/bin/pi
elif command -v pi >/dev/null 2>&1; then
    pi_command=$(command -v pi)
elif [ -x "$HOME/.local/bin/pi" ]; then
    pi_command=$HOME/.local/bin/pi
else
    printf 'Pi was not found on PATH or in a standard user installation.\n' >&2
    exit 1
fi

auto_model=1
for arg in "$@"; do
    case "$arg" in
        -m|--model|--model=*|--provider|--provider=*) auto_model=0 ;;
    esac
done

if [ "$auto_model" -eq 1 ] && [ "${PI_SKIP_SPARK_MODEL_DISCOVERY:-0}" != 1 ]; then
    if [ -x "$HOME/.local/share/pi-node/current/bin/node" ]; then
        node_command=$HOME/.local/share/pi-node/current/bin/node
    elif command -v node >/dev/null 2>&1; then
        node_command=$(command -v node)
    else
        printf 'Node.js is required to discover the loaded Spark model.\n' >&2
        exit 1
    fi

    if ! spark_base_url=$("$node_command" -e '
        const fs = require("node:fs");
        try {
            const config = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
            const url = new URL(config.providers?.spark?.baseUrl);
            if (url.protocol !== "http:" && url.protocol !== "https:") process.exit(1);
            process.stdout.write(url.toString().replace(/\/+$/, ""));
        } catch { process.exit(1); }
    ' "$HOME/.pi/agent/models.json"); then
        printf 'Could not read providers.spark.baseUrl from ~/.pi/agent/models.json.\n' >&2
        exit 1
    fi

    # shortcut: assumes the Spark serves exactly one model; pass --model to override.
    if ! spark_models=$(curl -fsS --max-time 3 "$spark_base_url/models"); then
        printf 'Could not reach the configured Spark model endpoint.\n' >&2
        exit 1
    fi
    if ! spark_model=$(printf '%s' "$spark_models" |
        "$node_command" -e '
            let input = "";
            process.stdin.on("data", chunk => input += chunk);
            process.stdin.on("end", () => {
                try {
                    const models = JSON.parse(input).data;
                    if (!Array.isArray(models) || models.length !== 1 || typeof models[0].id !== "string") process.exit(1);
                    process.stdout.write(models[0].id);
                } catch { process.exit(1); }
            });
        '); then
        printf 'Could not discover exactly one model from the Spark tunnel. Use --model spark/<id> to override.\n' >&2
        exit 1
    fi
    set -- --model "spark/$spark_model" "$@"
fi

exec "$pi_command" \
    --append-system-prompt "$root/research-support.md" \
    "$@"
