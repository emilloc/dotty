#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { createHash } = require("node:crypto");
const { spawnSync } = require("node:child_process");

const args = process.argv.slice(2);
if (args.length === 1 && ["--help", "-h"].includes(args[0])) {
    console.log("Usage: pi-brief TASK_STATE.json RESEARCH.md\nOpens a fresh Pi briefing conversation using your configured default model.");
    process.exit(0);
}
if (args.length !== 2) {
    console.error("Usage: pi-brief TASK_STATE.json RESEARCH.md");
    process.exit(1);
}

let snapshotDir;
try {
    const sources = args.map((file) => path.resolve(file));
    const contents = sources.map((file) => fs.readFileSync(file));
    const state = JSON.parse(contents[0].toString("utf8"));
    if (!state || typeof state.objective !== "string" || !Number.isInteger(state.revision)
        || typeof state.updatedAt !== "string") {
        throw new Error("Task state must contain objective, revision, and updatedAt.");
    }
    if (!contents[1].toString("utf8").trim()) throw new Error("Research record is empty.");
    // shortcut: detect overlapping writes, but the operator must choose a completed milestone.
    if (sources.some((file, i) => !fs.readFileSync(file).equals(contents[i]))) {
        throw new Error("Inputs changed during capture. Retry after the milestone finishes.");
    }

    const root = path.dirname(fs.realpathSync(__filename));
    const systemPrompt = fs.readFileSync(path.join(root, "briefing-prompt.md"), "utf8");
    snapshotDir = fs.mkdtempSync(path.join(os.tmpdir(), "pi-brief-"));
    const snapshots = ["task-state.json", "RESEARCH.md"].map((name, i) => {
        const file = path.join(snapshotDir, name);
        fs.writeFileSync(file, contents[i], { mode: 0o600 });
        return `@${file}`;
    });
    const metadata = {
        capturedAt: new Date().toISOString(),
        revision: state.revision,
        updatedAt: state.updatedAt,
        sources: sources.map((file, i) => ({
            path: file,
            sha256: createHash("sha256").update(contents[i]).digest("hex"),
        })),
    };
    const agentDir = path.resolve(process.env.PI_CODING_AGENT_DIR || path.join(os.homedir(), ".pi", "agent"));
    const managedPi = path.join(agentDir, "bin", "pi");
    const pi = fs.existsSync(managedPi) ? managedPi : "pi";
    const sessionDir = path.join(agentDir, "sessions", "briefings");
    console.error(`Opening briefing for revision ${state.revision}. Sessions: ${sessionDir}`);
    const result = spawnSync(pi, [
        "--offline", "--no-tools", "--no-extensions", "--no-mcp", "--no-skills",
        "--no-context-files", "--no-prompt-templates",
        "--session-dir", sessionDir,
        "--name", `Briefing: ${path.basename(path.dirname(sources[1]))} r${state.revision}`,
        "--system-prompt", systemPrompt,
        "--", ...snapshots,
        `Generate the initial operator briefing from these captured records. Follow-up questions refer to this snapshot unless new evidence is supplied. Capture metadata:\n${JSON.stringify(metadata, null, 2)}`,
    ], { stdio: "inherit", cwd: snapshotDir });
    if (result.error) throw result.error;
    process.exitCode = result.status ?? 1;
} catch (error) {
    console.error(`pi-brief: ${error.message}`);
    process.exitCode = 1;
} finally {
    if (snapshotDir) fs.rmSync(snapshotDir, { recursive: true, force: true });
}
